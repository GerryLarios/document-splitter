{
  "name": "@book-splicer/web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "assets": "node scripts/assets.mjs",
    "dev": "pnpm assets && NEXT_TELEMETRY_DISABLED=1 next dev --webpack",
    "build": "pnpm assets && NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@xmldom/xmldom": "^0.8.11",
    "fflate": "^0.8.2",
    "lucide-react": "^0.577.0",
    "next": "^16.2.0",
    "node-unrar-js": "2.0.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-virtuoso": "^4.18.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.2.0",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
